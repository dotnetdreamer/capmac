{
  "name": "capmac-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "CapMac: Pair to Mac for Capacitor. The CLI (packages/cli), the shared engine (packages/core) and CapMac Studio (apps/desktop).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/desktop",
    "services/signal"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run build -w capmac",
    "watch": "npm run watch -w capmac",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @capmac/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "npm run dev -w @capmac/desktop",
    "desktop:build": "npm run dist -w @capmac/desktop",
    "desktop:test": "npm run test:e2e -w @capmac/desktop",
    "intro:studio": "npm --prefix apps/intro run studio",
    "intro:render": "npm --prefix apps/intro run render",
    "intro:poster": "npm --prefix apps/intro run poster",
    "intro:check": "npm --prefix apps/intro run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/plist": "^3.0.5",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
