{
  "name": "capmac-workspace",
  "version": "0.1.2",
  "private": true,
  "description": "CapMac: build and run iPhone, Mac and Windows apps from Windows. The CLI (packages/cli), the shared engine (packages/core), CapMac Studio (apps/desktop) and the VS Code extension (apps/vscode).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/desktop",
    "apps/vscode",
    "services/signal"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run build -w capmac",
    "watch": "npm run watch -w capmac",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @capmac/desktop && npm run typecheck -w capmac-vscode",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "npm run dev -w @capmac/desktop",
    "desktop:build": "npm run dist -w @capmac/desktop",
    "desktop:test": "npm run test:e2e -w @capmac/desktop",
    "vscode:build": "npm run build -w capmac-vscode",
    "vscode:watch": "npm run watch -w capmac-vscode",
    "vscode:package": "npm run package -w capmac-vscode",
    "vscode:test": "npm run test:integration -w capmac-vscode",
    "intro:studio": "npm --prefix apps/intro run studio",
    "intro:render": "npm --prefix apps/intro run render",
    "intro:render:vscode": "npm --prefix apps/intro run render:vscode",
    "intro:poster": "npm --prefix apps/intro run poster",
    "intro:poster:vscode": "npm --prefix apps/intro run poster:vscode",
    "intro:check": "npm --prefix apps/intro run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/plist": "^3.0.5",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
