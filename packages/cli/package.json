{
  "name": "capmac",
  "version": "0.1.1",
  "description": "Pair to Mac for Capacitor: build, run, live-reload and see your iOS app on a remote Mac, straight from Windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotnetdreamer/capmac.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "capmac": "./bin/capmac.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "keywords": [
    "capacitor",
    "ios",
    "xcode",
    "windows",
    "remote",
    "pair-to-mac",
    "simulator",
    "live-reload"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "commander": "^15.0.0",
    "ignore": "^7.0.12",
    "multicast-dns": "^7.2.5",
    "picocolors": "^1.1.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@capmac/core": "0.1.1"
  },
  "optionalDependencies": {
    "node-datachannel": "0.33.4"
  }
}
