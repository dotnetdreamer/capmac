{
  "name": "@capmac/desktop",
  "productName": "CapMac Studio",
  "version": "0.1.1",
  "private": true,
  "description": "CapMac Studio: build, run, live-reload and see your Capacitor iOS app on a Mac, from Windows.",
  "license": "MIT",
  "author": "capmac",
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/dist.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "node scripts/build.mjs && playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@capmac/core": "0.1.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.4",
    "vite": "8.3.4",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  }
}
